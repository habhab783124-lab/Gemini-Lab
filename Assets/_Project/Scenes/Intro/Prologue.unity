    text: "\t\u6697\u7EA2\u7684\u90A3\u7C92\u4E5F\u5728\u957F\u3002\u5148\u662F\u5C3E\u90E8\u4F38\u51FA\u4E00\u9053\u7EC6\u957F\u7684\u5F27\uFF0C\u50CF\u5C3E\u5DF4\u7684\u96CF\u5F62\u3002\u7136\u540E\u4E24\u5904\u5C0F\u5C0F\u7684\u7A81\u8D77\u4ECE\u5149\u7403\u7684\u9876\u7AEF\u5192\u51FA\u6765\uFF0C\u8D8A\u6765\u8D8A\u6E05\u6670\uFF0C\u50CF\u89D2\u7684\u5F62\u72B6\u3002\r"
