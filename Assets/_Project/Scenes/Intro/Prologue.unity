  - video: {fileID: 32900000, guid: cb3d3f1515b1cd14190d8bd0e3684ce4, type: 3}
    text: "\t\u6211\u4E0D\u77E5\u9053\u5B83\u4EEC\u662F\u4EC0\u4E48\u3002\u6211\u53EA\u77E5\u9053\u5B83\u4EEC\u6216\u8BB8\u4E0D\u8BE5\u88AB\u7559\u5728\u90A3\u91CC\u3002\r\n\r\n\t\u4E8E\u662F\u6211\u627E\u4E86\u4E24\u53EA\u900F\u660E\u7684\u73BB\u7483\u74F6\uFF0C\u5C06\u5B83\u4EEC\u8F7B\u8F7B\u6536\u4E86\u8FDB\u53BB\u3002\u6696\u767D\u7684\u653E\u8FDB\u5DE6\u8FB9\u7684\u74F6\u5B50\uFF0C\u6697\u7EA2\u7684\u653E\u8FDB\u53F3\u8FB9\u7684\u74F6\u5B50\u3002\u74F6\u53E3\u6CA1\u6709\u5C01\u4F4F\uFF0C\u6211\u53EA\u662F\u628A\u5B83\u4EEC\u653E\u5728\u684C\u4E0A\u3002\u7A97\u5F00\u7740\u3002\u98CE\u80FD\u5439\u8FDB\u6765\u3002\r\n\r\n\t\u5B83\u4EEC\u6CA1\u6709\u9192\uFF0C\u4E5F\u6CA1\u6709\u706D\u3002\u53EA\u662F\u5728\u74F6\u5B50\u91CC\u5B89\u5B89\u9759\u9759\u5730\u5F85\u7740\u3002\r"
    illustration: {fileID: 0}
    textOffset: {x: -457, y: 73}
    textBoxSize: {x: 700, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: fd0e12c1bf36ff245bf319f9ee4e46fd, type: 3}
    text: "\t\u6211\u5728\u684C\u4E0A\u517B\u4E86\u90A3\u4E24\u7C92\u5149\u8BB8\u591A\u65E5\u5B50\u3002\u8D77\u521D\u5B83\u4EEC\u53EA\u662F\u4EAE\u7740\uFF0C\u4E0D\u5206\u663C\u591C\u3002\r"
