    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 88ab7a17e53456a4798070b4aaa0268e, type: 3}
    text: "\t\u4F46\u8D70\u5230\u56ED\u5B50\u53E6\u4E00\u5934\u65F6\uFF0C\u6211\u5728\u667A\u6167\u6811\u7684\u6839\u65C1\uFF0C\u53C8\u770B\u89C1\u4E86\u4E00\u7C92\u6697\u7EA2\u8272\u7684\u5149\u3002\u4E24\u7C92\u5149\uFF0C\u9694\u7740\u4E00\u6574\u7247\u56ED\u5B50\uFF0C\u5374\u50CF\u662F\u540C\u4E00\u6837\u4E1C\u897F\u5206\u6210\u4E86\u4E24\u534A\u3002\r"
