  - video: {fileID: 32900000, guid: 39f741a5e1f15b34889a66f047bea7bd, type: 3}
    text: "\t\u56ED\u5B50\u4E2D\u592E\u957F\u7740\u4E24\u68F5\u6811\u3002\r\n\n\t\u667A\u6167\u6811\u7ACB\u4E8E\u6CB3\u6C34\u5DE6\u5CB8\uFF0C\u9634\u5F71\u4E2D\u94F6\u84DD\u8272\u7684\u679C\u5B9E\u4EFF\u4F5B\u5FAE\u7F29\u7684\u661F\u4E91\uFF0C\u4F20\u8BF4\u90A3\u91CC\u5C01\u5B58\u7740\u5584\u6076\u7684\u5965\u79D8\uFF0C\u4EA6\u662F\u88AB\u7981\u6B62\u91C7\u6458\u7684\u7981\u679C\u3002"
    illustration: {fileID: 0}
    textOffset: {x: 603, y: 321}
    textBoxSize: {x: 600, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 3940768074129324ca7722d0388fd345, type: 3}
    text: "\t\u751F\u547D\u6811\u7ACB\u4E8E\u6CB3\u6C34\u53F3\u5CB8\uFF0C\u5149\u4EAE\u4E0B\u7EAF\u91D1\u8272\u7684\u679C\u5B9E\u4EFF\u4F5B\u66D9\u5149\u5973\u795E\u53D1\u9876\u7684\u51A0\u5195\uFF0C\u4F20\u8BF4\u5176\u95F4\u6D41\u6DCC\u7740\u4E0D\u706D\u7684\u751F\u673A\uFF0C\u662F\u88AB\u7981\u6B62\u91C7\u6458\u7684\u7981\u679C\u3002"
    illustration: {fileID: 0}
    textOffset: {x: -635, y: 64}
    textBoxSize: {x: 600, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 70ffc3a80c8e3c44485a49bef527b7ed, type: 3}
    text: "\t\u751F\u547D\u4E4B\u6CB3\u81EA\u4F0A\u7538\u56ED\u5FC3\u6D8C\u51FA\uFF0C\u6C34\u8272\u5982\u4E73\uFF0C\u6CDB\u7740\u6C38\u6052\u7684\u5149\u6CFD\uFF0C\u6D41\u7ECF\u4E4B\u5904\u4E07\u7269\u7E41\u8302\uFF0C\u6B23\u6B23\u5411\u8363\u3002"
    illustration: {fileID: 0}
    textOffset: {x: 566, y: 375}
    textBoxSize: {x: 700, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 78c1b8bfb3943d6418cec0e274d4444b, type: 3}
    text: "\t\u767D\u65E5\u6F2B\u957F\uFF0C\u65E5\u5149\u6696\u6D0B\u6D0B\u5730\u7167\u7740\u56ED\u5B50\u3002 "
    illustration: {fileID: 0}
    textOffset: {x: 270, y: 404}
    textBoxSize: {x: 700, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 8978bee36817fd047a0a2d104b9dae8b, type: 3}
    text: "\t\u4E00\u53EA\u8774\u8776\u505C\u5728\u751F\u547D\u6811\u7684\u6811\u679D\u4E0A\u6B47\u811A\u3002\u5B83\u7684\u7FC5\u8180\u662F\u91D1\u84DD\u8272\u7684\u2014\u2014\u592A\u9633\u5E95\u4E0B\u50CF\u788E\u5F00\u7684\u5B9D\u77F3\u3002\r\n\r\n\t\u5B83\u672C\u6765\u53EA\u662F\u6B47\u7740\uFF0C\u4F46\u4F4E\u5934\u7684\u65F6\u8FB0\uFF0C\u770B\u89C1\u4E00\u9897\u719F\u900F\u7684\u871C\u679C\u5782\u5728\u679D\u5934\uFF0C\u679C\u76AE\u88C2\u5F00\u4E00\u9053\u7EC6\u7EB9\uFF0C\u4E00\u6EF4\u91D1\u8272\u7684\u871C\u6B63\u4ECE\u88C2\u7F1D\u91CC\u6162\u6162\u6E17\u51FA\u3002"
    illustration: {fileID: 0}
    textOffset: {x: 456, y: -351}
    textBoxSize: {x: 700, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: e2c5bd66aa963c84491f643b037a6bce, type: 3}
    text: "\t\u8774\u8776\u843D\u4E86\u4E0B\u53BB\u3002\u5B83\u6CBE\u4E86\u4E00\u4E0B\u3002\r\n\r\n\t\u6CA1\u6709\u58F0\u97F3\u3002\u6CA1\u6709\u88C2\u5F00\u3002\u53EA\u662F\u4E00\u6EF4\u871C\u843D\u5728\u4E86\u8774\u8776\u7684\u89E6\u89D2\u4E0A\u3002\r"
    illustration: {fileID: 0}
    textOffset: {x: -686, y: -134}
    textBoxSize: {x: 500, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 643de1b25bae92f499d348bf8d5f1a35, type: 3}
    text: "\t\u540C\u4E00\u5929\u591C\u91CC\uFF0C\u6708\u5149\u50CF\u8584\u7EB1\u4E00\u6837\u94FA\u5728\u8349\u5730\u4E0A\u3002\u4E00\u53EA\u6DE1\u7EA2\u8272\u7684\u8424\u706B\u866B\u5728\u667A\u6167\u6811\u7684\u53F6\u5B50\u4E0B\u9762\u98DE\u3002\u5B83\u7684\u5C3E\u5DF4\u4E0A\u6709\u4E00\u70B9\u7EC6\u7EC6\u7684\u5149\uFF0C\u50CF\u4E00\u9897\u4F1A\u547C\u5438\u7684\u661F\u3002\r\n\r\n\t\u5B83\u843D\u5728\u4E00\u7247\u5BBD\u5927\u7684\u53F6\u5B50\u4E0A\uFF0C\u53F6\u9762\u6709\u4E00\u6EF4\u9732\u6C34\u2014\u2014\u4F46\u90A3\u4E0D\u662F\u9732\u6C34\uFF0C\u662F\u679C\u5B9E\u6E17\u51FA\u7684\u6C41\u6C34\uFF0C\u50CF\u6781\u6DE1\u7684\u7425\u73C0\u8272\uFF0C\u51DD\u5728\u53F6\u8109\u4E4B\u95F4\u3002\r"
    illustration: {fileID: 0}
