    textBoxSize: {x: 700, y: 200}
    textAlignment: 513
    textColor: {r: 0.09803922, g: 0.050980393, b: 0.02745098, a: 1}
  - video: {fileID: 32900000, guid: 4e401322bf2b1984f93e4f9d5fba6121, type: 3}
    text: "\t\u8424\u706B\u866B\u7684\u89E6\u89D2\u78B0\u4E86\u4E0A\u53BB\u3002\u5B83\u4E5F\u6CBE\u4E86\u4E00\u4E0B\u3002\r"
    illustration: {fileID: 0}
