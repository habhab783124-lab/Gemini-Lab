    textAlignment: 513
    textColor: {r: 1, g: 1, b: 1, a: 1}
  - video: {fileID: 32900000, guid: c81d6b2ee819e184d900c0f784f8bef5, type: 3}
    text: "\t\u90A3\u53EA\u5E73\u51E1\u7684\u8774\u8776\u555C\u996E\u4E86\u91D1\u8272\u871C\u9732\uFF0C\u7FC5\u7FFC\u4FBF\u6E10\u6B21\u5316\u5F00\uFF0C\u6574\u53EA\u8776\u878D\u6210\u4E00\u56E2\u6696\u878D\u878D\u7684\u91D1\u8272\u5149\u7403\uFF0C\u8737\u7F29\u5230\u6811\u6839\u5904\u5FAE\u5FAE\u640F\u52A8\u3002\r"
