  notes:
  - id: note_angel_01
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u4F60\u7684\u4E66\u6389\u5728\u5730\u4E0A\u4E86\uFF0C\u6211\u653E\u56DE\u53BB\u4E86\u3002\u2026\u2026\u987A\u4FBF\u6545\u610F\u653E\u53CD\u4E86\u4E00\u672C\u3002\u770B\u770B\u4F60\u591A\u4E45\u80FD\u53D1\u73B0\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_02
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u8BB0\u5F97\u559D\u6C34\u3002\u53EA\u559D\u90A3\u4E9B\u5947\u602A\u7684\u996E\u6599\u4E0D\u7B97\u3002\u5173\u4E8E\u8FD9\u4E00\u70B9\u4E0D\u8981\u53CD\u9A73\u6211\u3002"
    visualType: 1
    weight: 1
  - id: note_angel_03
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u6211\u6570\u4E86\u4E00\u4E0B\uFF0C\u4F60\u4ECA\u5929\u5DF2\u7ECF\u628A\u4E1C\u897F\u968F\u624B\u4E22\u4E86\u56DB\u6B21\u3002\u7B2C\u4E94\u6B21\u7684\u65F6\u5019\uFF0C\u6211\u51B3\u5B9A\u4E0D\u63D0\u9192\u4F60\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_04
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u5E8A\u8FB9\u90A3\u53EA\u889C\u5B50\u2026\u2026\u6211\u672C\u6765\u51B3\u5B9A\u5F53\u4F5C\u6CA1\u770B\u89C1\u3002\u540E\u6765\u8FD8\u662F\u628A\u5B83\u8E22\u8FDC\u4E86\u4E00\u70B9\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_05
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u690D\u7269\u6709\u70B9\u7F3A\u6C34\uFF0C\u6211\u66FF\u4F60\u6D47\u4E86\u3002\u653E\u5FC3\uFF0C\u6CA1\u6709\u6309\u7167\u6211\u7684\u6807\u51C6\u91CD\u65B0\u6392\u5217\u4F60\u7684\u82B1\u3002\u5DEE\u4E00\u70B9\u800C\u5DF2\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_06
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u5982\u679C\u4F60\u5728\u627E\u90A3\u652F\u7B14\uFF0C\u5B83\u6EDA\u5230\u67DC\u5B50\u4E0B\u9762\u53BB\u4E86\u3002\u6211\u5176\u5B9E\u5341\u5206\u949F\u524D\u5C31\u770B\u89C1\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_07
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u623F\u95F4\u4ECA\u5929\u5F88\u5B89\u9759\u3002\u96BE\u5F97\u3002\u2026\u2026\u5B89\u9759\u592A\u4E45\u4E4B\u540E\uFF0C\u597D\u50CF\u53C8\u6709\u4E00\u70B9\u4E0D\u4E60\u60EF\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_08
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u684C\u4E0A\u7684\u96F6\u98DF\u653E\u592A\u4E45\u4E86\uFF0C\u6211\u5DF2\u7ECF\u66FF\u4F60\u201C\u5904\u7406\u201D\u6389\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_09
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u4F60\u7684\u753B\u6211\u6CA1\u6709\u52A8\u3002\u4E0D\u8FC7\u2026\u2026\u989C\u8272\u642D\u5F97\u8FD8\u4E0D\u9519\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_10
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u8DEF\u8FC7\u65F6\u542C\u89C1\u4F60\u5728\u73A9\u6E38\u620F\u3002\uFF08\u4F60\u600E\u4E48\u90FD\u4E0D\u6765\u627E\u6211\u73A9\u2014\u2014\u5212\u6389\uFF09"
    visualType: 0
    weight: 1
  - id: note_angel_11
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u6211\u628A\u5730\u4E0A\u7684\u7EB8\u6361\u8D77\u6765\u4E86\u3002\u6709\u4E00\u5F20\u753B\u5F97\u633A\u6709\u610F\u601D\uFF0C\u88AB\u6211\u6682\u65F6\u6CA1\u6536\u3002\u4E4B\u540E\u4F1A\u8FD8\u4F60\u7684\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_12
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u4F60\u7684\u8D1D\u65AF\u653E\u56DE\u67B6\u5B50\u4E0A\u4E86\u3002\u5730\u4E0A\u4E0D\u662F\u5B83\u8BE5\u5F85\u7684\u5730\u65B9\uFF0C\u867D\u7136\u6211\u77E5\u9053\u4F60\u662F\u6545\u610F\u4E71\u653E\u7684\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_13
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u62E8\u7247\u6389\u5728\u97F3\u54CD\u540E\u9762\u4E86\uFF0C\u6211\u66FF\u4F60\u62FF\u51FA\u6765\u653E\u5728\u684C\u4E0A\u3002\u4E0B\u6B21\u53EF\u4EE5\u4E0D\u8981\u4EC0\u4E48\u90FD\u5F80\u89D2\u843D\u91CC\u8E22\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_14
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u97F3\u54CD\u65C1\u8FB9\u90A3\u51E0\u5F20\u7EB8\u6211\u66FF\u4F60\u53E0\u597D\u4E86\u3002\u653E\u5FC3\uFF0C\u5185\u5BB9\u6211\u6CA1\u7EC6\u770B\u2014\u2014\u867D\u7136\u6700\u4E0A\u9762\u90A3\u53E5\u786E\u5B9E\u5F88\u4E0D\u50CF\u4F60\u4F1A\u5199\u7684\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_15
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u6211\u539F\u672C\u4EE5\u4E3A\u955C\u5B50\u662F\u623F\u95F4\u88C5\u9970\u3002\u73B0\u5728\u770B\u6765\uFF0C\u5B83\u53EF\u80FD\u662F\u4F60\u4F7F\u7528\u9891\u7387\u6700\u9AD8\u7684\u5BB6\u5177\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_16
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u521A\u624D\u90A3\u6BB5\u5F88\u597D\u542C\u3002\u867D\u7136\u5982\u679C\u6211\u73B0\u5728\u5938\u4F60\uFF0C\u4F60\u5927\u6982\u4F1A\u5F97\u610F\u4E00\u6574\u5929\uFF0C\u6240\u4EE5\u5F53\u6211\u6CA1\u5199\u3002"
    visualType: 0
    weight: 1
  - id: note_angel_17
    senderCharacter: Angel
    receiverCharacter: Demon
    content: "\u4F60\u5F39\u8D1D\u65AF\u7684\u65F6\u5019\u786E\u5B9E\u6BD4\u5E73\u65F6\u5B89\u9759\u4E00\u70B9\u3002\u5F88\u795E\u5947\uFF0C\u660E\u660E\u623F\u95F4\u53CD\u800C\u66F4\u5435\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_01
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u7684\u4E66\u6446\u5F97\u4E5F\u592A\u6574\u9F50\u4E86\u3002\u770B\u5F97\u6211\u6709\u70B9\u60F3\u6545\u610F\u62BD\u6B6A\u4E00\u672C\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_02
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u7A97\u8FB9\u6652\u592A\u9633\u7684\u4F4D\u7F6E\u8FD8\u4E0D\u9519\u561B\u3002\u6682\u65F6\u5F81\u7528\u4E86\u5341\u5206\u949F\u3002"
    visualType: 1
    weight: 1
  - id: note_demon_03
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u7684\u623F\u95F4\u8FD8\u662F\u8FD9\u4E48\u4EAE\u3002\u773C\u775B\u90FD\u5FEB\u88AB\u95EA\u5230\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_04
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u6211\u672C\u6765\u60F3\u753B\u70B9\u4E1C\u897F\u5728\u8FD9\u5F20\u7EB8\u4E0A\u3002\u7B97\u4E86\uFF0C\u7ED9\u4F60\u7559\u4E2A\u5708\u3002\u25CE"
    visualType: 0
    weight: 1
  - id: note_demon_05
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u5E8A\u770B\u8D77\u6765\u633A\u8212\u670D\u7684\u3002\u6211\u53EA\u662F\u8BC4\u4EF7\u4E00\u4E0B\uFF0C\u6CA1\u8EBA\u3002\u771F\u7684\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_06
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4ECA\u5929\u4EC0\u4E48\u6076\u4F5C\u5267\u90FD\u6CA1\u505A\u3002\u4F60\u6700\u597D\u73CD\u60DC\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_07
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u672C\u6765\u53EA\u662F\u8DEF\u8FC7\uFF0C\u7ED3\u679C\u95E8\u5F00\u7740\u3002\u95E8\u5F00\u7740\u5C31\u662F\u9080\u8BF7\uFF0C\u5BF9\u5427\uFF1F\u8D70\u7684\u65F6\u5019\u6211\u5E2E\u4F60\u5173\u597D\u4E86\uFF0C\u522B\u60F3\u592A\u591A\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_08
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u7B14\u8BB0\u91CC\u5C45\u7136\u5199\u4E86\u4E00\u4E2A\u201C\uFF1F\u201D\u2014\u2014\u539F\u6765\u771F\u7684\u6709\u8FDE\u4F60\u4E5F\u4E0D\u77E5\u9053\u7684\u4E1C\u897F\u3002\u7A00\u5947\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_09
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u90A3\u76C6\u690D\u7269\u53C8\u5F80\u7A97\u6237\u90A3\u8FB9\u6B6A\u4E86\u3002\u770B\u6765\u5B83\u4E5F\u77E5\u9053\u54EA\u91CC\u5F85\u7740\u8212\u670D\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_10
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u6389\u4E86\u4E00\u7247\u53F6\u5B50\u3002\u6211\u672C\u6765\u60F3\u6254\u6389\uFF0C\u540E\u6765\u89C9\u5F97\u8FD8\u633A\u597D\u770B\uFF0C\u7ED9\u4F60\u5939\u4E66\u91CC\u4E86\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_11
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u6211\u8BD5\u7740\u5F39\u4E86\u4E24\u4E0B\u4F60\u7684\u7AD6\u7434\u3002\u6548\u679C\u975E\u5E38\u5E05\u3002\u53EF\u60DC\u4F60\u6CA1\u770B\u5230\u3002\u7B97\u4F60\u7684\u635F\u5931\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_12
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u672C\u6765\u60F3\u6765\u6363\u4E71\u7684\u3002\u7ED3\u679C\u5750\u4E0B\u6765\u4EE5\u540E\u7A81\u7136\u61D2\u5F97\u52A8\u4E86\u3002\u4ECA\u5929\u7B97\u4F60\u8D70\u8FD0\uFF0C\u4E0B\u6B21\u8865\u4E0A\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_13
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u7684\u4E66\u91CC\u5939\u7740\u597D\u591A\u7B14\u8BB0\u3002\u6211\u672C\u6765\u53EA\u662F\u968F\u4FBF\u770B\u770B\u2026\u2026\u4F60\u4E3A\u4EC0\u4E48\u8FDE\u5410\u69FD\u90FD\u5199\u5F97\u8FD9\u4E48\u5DE5\u6574\uFF1F"
    visualType: 0
    weight: 1
  - id: note_demon_14
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u521A\u624D\u5728\u7A97\u8FB9\u5750\u7740\u5750\u7740\u5DEE\u70B9\u7761\u7740\u3002\u4E00\u5B9A\u662F\u4F60\u623F\u95F4\u592A\u65E0\u804A\uFF0C\u4E0D\u662F\u56E0\u4E3A\u8FD9\u91CC\u5F88\u8212\u670D\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_15
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u6211\u53D1\u73B0\u4F60\u4E66\u67B6\u4E0A\u5C45\u7136\u6709\u51E0\u672C\u633A\u597D\u770B\u7684\u3002\u770B\u6765\u54C1\u5473\u8FD8\u4E0D\u9519\u561B\uFF01"
    visualType: 0
    weight: 1
  - id: note_demon_16
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u4F60\u5F39\u7AD6\u7434\u7684\u65F6\u5019\u786E\u5B9E\u633A\u50CF\u4E2A\u5929\u4F7F\u7684\u3002"
    visualType: 0
    weight: 1
  - id: note_demon_17
    senderCharacter: Demon
    receiverCharacter: Angel
    content: "\u8FD9\u672C\u6211\u62FF\u8D70\u4E86\u3002\u60F3\u8981\u56DE\u6765\uFF1F\u4E0B\u6B21\u6765\u6211\u623F\u95F4\u81EA\u5DF1\u627E\u3002"
    visualType: 0
    weight: 1
